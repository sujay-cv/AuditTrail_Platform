{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "AuditDb": "Host=localhost;Port=5432;Database=audittrail;Username=audit;Password=SET_VIA_ENVIRONMENT;Maximum Pool Size=50;Timeout=5;Command Timeout=30;Keepalive=30"
  },

  "Database": {
    "SeedDemoData": false
  },

  "Demo": {
    "TenantDirectory": false
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Ingestion": {
    "MaxBatchSize": 500,
    "MaxMetadataBytes": 16384,
    "FutureToleranceMinutes": 5,
    "MinOccurredAt": "2015-01-01T00:00:00Z"
  },

  "Search": {
    "MaxRangeDays": 90,
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "CursorSigningKey": ""
  },

  "Export": {
    "WorkerEnabled": true,
    "Directory": "exports",
    "ChunkSize": 500,
    "LeaseSeconds": 30,
    "MaxAttempts": 3,
    "PollSeconds": 2,
    "FileRetentionHours": 24,
    "DelayPerChunkMs": 0
  },

  "Retention": {
    "WorkerEnabled": true,
    "IntervalSeconds": 300,
    "BatchSize": 500
  }
}
