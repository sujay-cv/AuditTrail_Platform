# Copy to .env and adjust. Every value has a safe local default in docker-compose.yml.
# NOTHING here is a real secret: these values are for the local demo only.

# PostgreSQL (container + the connection string the API uses)
POSTGRES_DB=audittrail
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit_dev_password

# Signs pagination cursors (HMAC). All API instances must share the same value.
CURSOR_SIGNING_KEY=change-me-local-demo-cursor-key

# Seed two demo tenants with ~1,450 events on an empty database
SEED_DEMO_DATA=true

# Console (browser) -> API URL. Injected into the console at container start (not baked into the build).
API_BASE_URL=http://localhost:8080
# Console origin allowed by the API's CORS policy
CONSOLE_ORIGIN=http://localhost:3000

# Exports: demo slow-down so you can watch progress, cancel, or kill the API mid-export (0 = full speed)
EXPORT_DELAY_PER_CHUNK_MS=1000
EXPORT_CHUNK_SIZE=100
EXPORT_LEASE_SECONDS=30

# Retention + checkpoint worker interval (seconds)
RETENTION_INTERVAL_SECONDS=300

# pgAdmin (optional, `docker compose --profile tools up`)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
